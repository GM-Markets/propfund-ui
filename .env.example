# ── hyperscaled-api connection ────────────────────────────────────────────
HSC_API_BASE_URL=http://localhost:8000
HSC_CLIENT_ID=hsc_replace_me
HSC_CLIENT_SECRET=hsk_replace_me
# OAuth scope(s) granted to this app's bearer token. The default ``api`` is a
# back-compat superscope that satisfies every route. To least-privilege a
# deployment you can ask for a space-separated subset of:
#   reads trading payments payouts connect kyc api_keys webhooks agreements
# The API rejects scopes the tenant isn't allowed to grant with HTTP 400
# (``V2_INVALID_SCOPE``) — coordinate the allowed_scopes list with platform
# admin before narrowing this value.
HSC_SCOPE=api

# ── Session cookie ────────────────────────────────────────────────────────
SESSION_COOKIE_NAME=hsc_starter_session
SESSION_COOKIE_SECRET=change-me-32-bytes-min-aaaaaaaaaaaa

# ── Public ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_HSC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=PropFund
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# GM gateway (waitlist and other public product APIs). No trailing slash.
NEXT_PUBLIC_GATEWAY_URL=https://api.dev.gm.markets

# Host port published by docker compose (container always listens on 3000).
APP_PORT=3000

# ── Outbound webhook ──────────────────────────────────────────────────────
HSC_WEBHOOK_SECRET=
