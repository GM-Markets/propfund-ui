# Propfund environment (PRD §13). Copy to .env.local for development.
# All values are public and inlined at build time.

# Sign-in app ID. Required for real sign-in. Leave empty for local test mode.
NEXT_PUBLIC_PRIVY_APP_ID=

# Sign-in client ID. Optional.
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# "true" shows the test controls drawer and, when NEXT_PUBLIC_PRIVY_APP_ID is
# empty, "Continue as test user". Never set in production.
NEXT_PUBLIC_TEST_CONTROLS=

# Published Arbitrum payout wallet shown on the transparency page.
# Empty shows "Published at launch".
NEXT_PUBLIC_PAYOUT_WALLET_ARBITRUM=

# JSON map of chain → treasury address for the transparency page, e.g.
# {"arbitrum":"0x…","ethereum":"0x…","base":"0x…","bnb":"0x…"}
NEXT_PUBLIC_TREASURY_ADDRESSES=

# Local production review build only: keeps the test controls and the local test
# sign-in in a `next build` so navigation is prefetched and instant.
# NEVER set this for the deployed app.
NEXT_PUBLIC_DEMO_BUILD=
