# Flo gateway — Privy JWT in, /van proxied to Vanta. Auth is on the gateway.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:6701
# Live desk marks — Hyperliquid allMids (not Flo /hyp).
NEXT_PUBLIC_HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
VANTA_API_BASE_URL=http://localhost:6701/van
# Must match the gateway's GATEWAY_WS_AUTH_SECRET (server-only; never NEXT_PUBLIC_).
GATEWAY_WS_AUTH_SECRET=cmFuZG9tLXNlY3JldC1rZXktZm9yLWZlZWQ=

# Same Privy app as GM Markets (app id + web client id)
NEXT_PUBLIC_PRIVY_APP_ID=cmpiif7km00970cjl14ht8ojb
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# HttpOnly cookie holding the Privy identity token
SESSION_COOKIE_NAME=vanta_privy_session

# Local `next dev` only. `./scripts/deploy.sh` replaces loopback URLs:
#   SITE     dev → https://dev.propfund.io  (pvt/prod similarly)
#   GATEWAY  → https://gate.propfund.io
#   VANTA    → https://gate.propfund.io/van
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PropFund

# Host listen port when not using scripts/deploy.sh.
# Deploy slots: ./scripts/deploy.sh dev → 5711, pvt → 5611, prod → 5411
APP_PORT=3000
VANTA_WEBHOOK_SECRET=
